{
  "expo": {
    "name": "WorthKart",
    "slug": "worth-kart",
    "version": "1.0.6",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "worthkart",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.worthkart.app",
      "icon": "./assets/images/logo.png"
    },
    "android": {
      "package": "com.worthkart.app",
      "versionCode": 7,
      "softwareKeyboardLayoutMode": "resize",
      "blockedPermissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#5b21b6",
        "foregroundImage": "./assets/images/logo.png"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.ico"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#5b21b6"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-sharing",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://worthkart.in",
      "eas": {
        "projectId": "ba4afee1-d6bc-4c1b-958f-1ad8d86b3806"
      }
    },
    "owner": "nazim_saifi"
  }
}
