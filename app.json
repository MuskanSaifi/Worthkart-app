{
  "expo": {
    "name": "WorthKart",
    "slug": "worth-kart",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "worthkart",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.worthkart.app"
    },
    "android": {
      "package": "com.worthkart.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#5b21b6",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#5b21b6"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "http://192.168.1.150:3000",
      "eas": {
        "projectId": "ba4afee1-d6bc-4c1b-958f-1ad8d86b3806"
      }
    },
    "owner": "nazimsaifi"
  }
}
